# Gemini API Key (Required for AI Audit evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Defaults to gemini-flash-latest or gemini-3.7-flash)
GEMINI_MODEL=gemini-flash-latest

# API Server Configuration
PORT=3030
HOST=0.0.0.0
NODE_ENV=development

# Website Tool / Crawler Safety Limits
MAX_REDIRECTS=5
FETCH_TIMEOUT_MS=10000
MAX_RESPONSE_BYTES=5242880
USER_AGENT=AIWebsiteAuditor/1.0 (+https://github.com/ai-website-auditor)
